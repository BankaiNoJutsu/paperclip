{
  "schemaVersion": 1,
  "slug": "deepseek",
  "name": "DeepSeek",
  "description": "Connect DeepSeek accounts for your agents.",
  "categories": [
    "ai"
  ],
  "branding": {
    "logoUrl": "/brands/apps/deepseek.svg",
    "darkLogoUrl": "/brands/apps/deepseek-dark.svg"
  },
  "urlPatterns": [
    "https://api.deepseek.com/*"
  ],
  "methods": [
    {
      "key": "ai-api_key",
      "label": "DeepSeek API key",
      "purpose": "ai",
      "transport": "runtime_auth",
      "auth": "api_key",
      "ai": {
        "provider": "deepseek",
        "method": "api_key"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "Authenticate an agent with this account.",
      "guidanceMd": "Use your personal account or an explicitly shared company account.",
      "riskTier": "S3",
      "credentialFields": [
        {
          "key": "apiKey",
          "label": "API key",
          "type": "password",
          "required": true,
          "placeholder": "Enter API key",
          "secret": true
        }
      ],
      "keyPlacement": {
        "location": "env",
        "name": "DEEPSEEK_API_KEY"
      }
    }
  ]
}
